{
  "name": "@conitepay/react-native",
  "version": "0.1.1",
  "description": "React Native bindings for the payment gateway",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-webview": ">=13.0.0"
  },
  "dependencies": {
    "@conitepay/core": "^0.1.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/dom": "^10.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^24.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.7",
    "react-native-webview": "^13.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

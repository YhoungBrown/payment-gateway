# Get your secret key from https://dashboard.paystack.com/
PAYSTACK_SECRET_KEY=get_your_paystack_secret_key

# Get your secret key from https://dashboard.flutterwave.com/
FLUTTERWAVE_SECRET_KEY=get_your_flutterwave_secret_key

# Callback URL used by Paystack. For Vercel, use your deployment URL + /callback.
# For local dev, the backend will auto-detect the host if this is empty.
PAYSTACK_CALLBACK_URL=

# Callback URL used by Flutterwave. For Vercel, use your deployment URL + /flutterwave-callback.
# For local dev, the backend will auto-detect the host if this is empty.
FLUTTERWAVE_CALLBACK_URL=


# --- Interswitch configuration ---
# You only need ONE of the following two auth methods:
#   Option A: Paste your bearer token directly (simpler)
#   Option B: Provide client_id, client_secret, and passport_url
#             (the backend will generate tokens automatically)
# If you provide both, the bearer token takes precedence.
# Get these from your Interswitch dashboard.

INTERSWITCH_MERCHANT_CODE=get_your_interswitch_merchant_code

# Option A: Bearer token (takes precedence if set)
INTERSWITCH_BEARER_TOKEN=get_your_interswitch_bearer_token

# Option B: OAuth credentials (used only if bearer token is not set)
INTERSWITCH_CLIENT_ID=get_your_interswitch_client_id
INTERSWITCH_CLIENT_SECRET=get_your_interswitch_client_secret
INTERSWITCH_PASSPORT_URL=https://your-interswitch-passport-url
INTERSWITCH_PAYMENTGATEWAY_API_URL=https://your-interswitch-paymentgateway-api-url
# Get your secret key from https://dashboard.paystack.com/
PAYSTACK_SECRET_KEY='Get your secret key from your paystack dashboard'

# Get your secret key from https://dashboard.flutterwave.com/
FLUTTERWAVE_SECRET_KEY= 'Get your secret key from your flutterwave dashboard'

# Callback URL used by Paystack. For Vercel, use your deployment URL + /callback.
# For local dev, this backend will auto-detect the host if this is empty.
PAYSTACK_CALLBACK_URL=

# Callback URL used by Flutterwave. For Vercel, use your deployment URL + /flutterwave-callback.
# For local dev, this backend will auto-detect the host if this is empty.
FLUTTERWAVE_CALLBACK_URL=


INTERSWITCH_MERCHANT_CODE= 'Get your merchant code from your interswitch business dashboard'
INTERSWITCH_BEARER_TOKEN= 'Get your bearer token (client id and secret) from your interswitch business dashboard'